.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
src/*.egg-info/
src/**/*.egg-info/

# Credentials and secrets
.env
credential.env
credentials.env
*credential*.env
*credentials*.env
.env.*
!.env.example

*.pem
*.key
*.json.secret
ee-davidproject-*.json
*service-account*.json
*credentials*.json
*credential*.json

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.docx
~$*.docx

# Caches
.cache/
gee_cache/
osmnx_cache/

# Large raw data files
data/raw/**/*.tif
data/raw/**/*.tiff
data/raw/**/*.gpkg
data/raw/**/*.parquet
data/raw/**/*.geojson
data/raw/**/*.csv

# Large processed data files
data/processed/**/*.tif
data/processed/**/*.tiff
data/processed/**/*.gpkg
data/processed/**/*.parquet
data/processed/**/*.geojson
data/processed/**/*.csv

# Keep lightweight data documentation
!data/raw/MANIFEST.md
!data/processed/PROCESSING_LOG.md
!data/external/references/**
!data/**/*.metadata.json

# Large generated outputs
outputs/figures/maps/*.png
outputs/figures/maps/*.pdf
outputs/figures/charts/*.png
outputs/figures/charts/*.pdf
outputs/maps_interactive/*.html
outputs/tables/*.csv
outputs/tables/*.json
outputs/geotiffs/*.tif
outputs/geotiffs/*.tiff
outputs/run_log.md

# Keep final reports if intentionally committed
!outputs/reports/**
!outputs/reports/*.md

# Keep selected portfolio assets for README display
!docs/assets/
!docs/assets/*.png

# Ignore old platform-specific communication outputs
content/linkedin_post.md
content/linkedin_article.md
content/linkedin_upload_guide.md
outputs/linkedin/

# LaTeX and document auxiliary files
*.aux
*.log
*.out
*.toc
